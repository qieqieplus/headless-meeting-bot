# Headless Meeting Bot Configuration
# Copy this file to .env and fill in your values

# Zoom SDK Credentials (required)
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here

# Optional: Custom paths
# SRC_DIR=../src
# BUILD_DIR=../src/build
# EXECUTABLE=../src/build/headless_zoom_bot_c
# OUTPUT_DIR=video

# Optional: Custom .env file location (for advanced users)
# ENV_FILE=.env
